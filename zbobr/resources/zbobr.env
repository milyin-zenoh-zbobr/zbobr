# zbobr configuration for this domain project
#
# Required: GitHub repository whose issues the orchestrator processes (owner/repo)
ZBOBR_DOMAIN_REPO={{DOMAIN_REPO}}
#
# Required: GitHub user or organization where target repos are forked for implementation.
# Workers fork repos under this account to create feature branches and PRs.
ZBOBR_FORK_OWNER={{FORK_OWNER}}
#
# Optional: Default AI model when no model: label is set on an issue
# ZBOBR_DEFAULT_MODEL=gpt-5-mini
#
# Optional: Directory for agent workspaces (cloned repos, temp files)
# ZBOBR_WORKSPACE=./workspace
#
# Optional: Custom prompt files for agents (semicolon-separated paths, relative to domain repo root)
#
# Prompt file types:
#   *-workflow.md — Core agent instructions (workflow, MCP tools, output format) — loaded FIRST
#   common.md     — Shared custom prompts (architecture, domain knowledge, conventions)
#   planner.md    — Planner-specific custom prompts (planning standards, investigation guidelines)
#   worker.md     — Worker-specific custom prompts (implementation standards, testing requirements)
#
# Default for planner: prompts/planner-workflow.md;prompts/common.md;prompts/planner.md
# Default for worker:  prompts/worker-workflow.md;prompts/common.md;prompts/worker.md
#
# ZBOBR_PLANNER_PROMPTS="prompts/planner-workflow.md;prompts/common.md;prompts/planner.md"
# ZBOBR_WORKER_PROMPTS="prompts/worker-workflow.md;prompts/common.md;prompts/worker.md"
#
# GitHub token (set in your environment, not in this file):
#   export GH_TOKEN=$(gh auth token)
# Or create a token at https://github.com/settings/tokens (needs 'repo' scope)
