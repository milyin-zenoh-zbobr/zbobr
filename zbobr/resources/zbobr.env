# zbobr configuration for this domain project
#
# Required:
ZBOBR_DOMAIN_REPO={{DOMAIN_REPO}}
ZBOBR_FORK_OWNER={{FORK_OWNER}}
#
# Optional:
# ZBOBR_DEFAULT_MODEL=gpt-5-mini
# ZBOBR_WORKSPACE=./workspace
# ZBOBR_PLANNER_PROMPT=/path/to/planner.md
# ZBOBR_WORKER_PROMPT=/path/to/worker.md
#
# GitHub token (set in your environment, not here):
# GH_TOKEN=ghp_...
