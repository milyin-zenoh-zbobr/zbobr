# zbobr configuration
# Priority: CLI args > env vars > this file > defaults

# Task project repository ("owner/repo")
task_repo = "{{TASK_REPO}}"

# GitHub user or org where target repos are forked
fork_owner = "{{FORK_OWNER}}"

# Default AI model (e.g. "gpt-5-mini", "claude-sonnet-4.5")
# default_model = "gpt-5-mini"

# Workspace directory for task work dirs
# workspace = "./workspace"

# Backend: "github" or "stub"
# backend = "github"

# CLI tool: "copilot", "claude", or "stub"
# cli_tool = "copilot"

# Prefix for work branches
# work_branch_prefix = "zbobr_fix"

# GitHub token with write access for orchestrator (used with octocrab for repo operations).
# Priority: ZBOBR_OWNER_GH_TOKEN > GH_TOKEN > GITHUB_TOKEN > $(gh auth token)
# Prefer env vars instead of storing in config.
# owner_github_token = ""

# GitHub token with read-only access for agent processes (passed as GH_TOKEN to agents).
# REQUIRED if agent tokens differ from owner token.
# Prefer ZBOBR_AGENT_GH_TOKEN env var instead of storing here.
# agent_github_token = ""

# GitHub token for Copilot CLI with Copilot's access rights (passed as COPILOT_GITHUB_TOKEN).
# Priority: ZBOBR_COPILOT_GITHUB_TOKEN > COPILOT_GITHUB_TOKEN > GH_TOKEN > GITHUB_TOKEN > $(gh auth token)
# Prefer env vars instead of storing in config.
# copilot_github_token = ""

# [prompts]
# Base directory for additional prompt files (appended after built-in instructions)
# path = "./prompts"
# Additional context files for planner (relative to path above, or absolute)
# planner = ["planner.md", "common.md"]
# Additional context files for worker
# worker = ["worker.md", "common.md"]
